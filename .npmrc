# Defensas supply-chain (preferencia global del usuario)
# - minimumReleaseAge: no instalar versiones publicadas hace menos de 1440 min (24h)
# - ignore-scripts: bloquear preinstall/postinstall por defecto (pnpm ya lo hace, lo dejamos explícito)
# - engine-strict: enforzar version de node/pnpm declarada en package.json
minimum-release-age=1440
ignore-scripts=true
engine-strict=true
strict-peer-dependencies=false
