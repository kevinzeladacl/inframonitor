# ============================================
# Inframonitor — variables de entorno
# ============================================
# Copia este archivo a `.env` y rellena los valores.
# El `.env` real NO se commitea.

NODE_ENV=development

# ----- Puertos -----
INFRA_API_PORT=8301
INFRA_WEB_PORT=5274

# ----- MongoDB -----
MONGO_PORT=27117
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=inframonitor_dev
# URI completa la arma el API (apps/api/src/config/db.ts) usando los valores de arriba.
# Override opcional:
# MONGO_URI=mongodb://admin:admin123@localhost:27117/inframonitor_dev?authSource=admin

# ----- Auth (Fase 1 — single user owner) -----
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-esto-en-produccion-32bytes-min
# Usuario seed (init-db lo crea si no existe)
OWNER_EMAIL=iam@kevinzelada.cl
OWNER_PASSWORD=cambia-esto-en-primer-login

# ----- Cifrado de credenciales cloud (Fase 3) -----
# Generar con: openssl rand -base64 32  (32 bytes para XSalsa20)
MASTER_KEY=

# ----- Cloud providers (configurables vía UI, este block es referencia) -----
# AWS: usar IAM user con AmazonEC2FullAccess + STS GetCallerIdentity
# DO: token con scopes read+write
# Azure: Service Principal (tenantId, clientId, clientSecret, subscriptionId)

# ----- API URL para el frontend -----
INFRA_API_URL=http://localhost:8301
